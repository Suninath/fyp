# Local Development Environment Configuration
# Copy this to .env.local and customize as needed

# ===== Server Configuration =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ===== Frontend Configuration =====
FRONTEND_URL=http://localhost:5173

# ===== Database Configuration =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=second_auto_gear_dev

# ===== JWT Configuration =====
JWT_SECRET=your-secret-key-for-local-dev
JWT_EXPIRE=7d

# ===== eSewa Payment Gateway =====
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_API_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_PAYMENT_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# For local development, use mock payments
MOCK_PAYMENTS=true

# ===== Khalti Payment Gateway (KPG-2 / Web Checkout) =====
# Sandbox: Get test keys from https://test-admin.khalti.com/ - Sign up as merchant
# Test Credentials: Khalti ID: 9800000000-9800000005, MPIN: 1111, OTP: 987654
# The API URLs are automatically determined based on NODE_ENV (dev.khalti.com for sandbox)
KHALTI_SECRET_KEY=05bf95cc57244045b8df5fad06748dab
KHALTI_PUBLIC_KEY=test_public_key_PASTE_HERE
KHALTI_MERCHANT_USERNAME=test_merchant
KHALTI_API_URL=https://dev.khalti.com/api/v2
KHALTI_RETURN_URL=http://localhost:3000/api/v1/bookings/payment/callback/khalti

# ===== Payment URLs =====
SUCCESS_URL=http://localhost:5173/payment-success
FAILURE_URL=http://localhost:5173/payment-failure

# ===== Cloudinary Configuration (for image uploads) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Email Configuration =====
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@secondautogear.com

# ===== Socket.IO Configuration =====
SOCKET_PORT=3001
SOCKET_CORS_ORIGIN=http://localhost:5173

# ===== Features =====
# Enable/disable payment mocking for local development
ENABLE_MOCK_PAYMENTS=true
# Use local payment URLs instead of actual gateways
USE_LOCAL_PAYMENTS=true
